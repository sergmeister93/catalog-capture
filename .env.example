# Service Photo POC — environment variables
# Copy to .env and fill in actual values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://servicephoto:servicephoto@localhost:5432/servicephoto

# --- Gemini / AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Storage paths (relative to repo root or absolute) ---
STORAGE_IMAGES_DIR=./storage/images
STORAGE_EXPORTS_DIR=./storage/exports
STORAGE_LOGS_DIR=./storage/logs

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
