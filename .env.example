# Catalog Capture - environment variables
# Copy to .env and fill in actual values. Never commit .env.

# --- Gemini / AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Storage ---
# Base directory for input_images/, inbound/, exports/, and catalog.db.
# Leave unset for local dev (defaults to the repo root). Hosted deployments
# point this at a persistent volume (the Dockerfile defaults it to /data).
# APP_DATA_DIR=

# --- Logging ---
# LOG_LEVEL=INFO
